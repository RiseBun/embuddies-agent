{
  "name": "embuddies-agent-runtime",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "verify": "node scripts/verify-embuddies-runtime.mjs",
    "verify:embuddies-runtime": "node scripts/verify-native-baseline.mjs",
    "verify:branding": "node scripts/verify-branding.mjs",
    "verify:workspace-replay": "node scripts/verify-workspace-replay.mjs",
    "verify:memory": "node scripts/verify-memory.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:web-form": "node scripts/verify-web-form.mjs",
    "verify:tools": "node scripts/verify-native-baseline.mjs",
    "verify:subagent": "node scripts/verify-native-baseline.mjs",
    "verify:resource-agent": "node scripts/verify-embuddies-runtime.mjs",
    "verify:resource-ui": "node scripts/verify-resource-ui.mjs",
    "verify:resource-analysis": "node scripts/verify-resource-analysis.mjs",
    "verify:resource-api": "node scripts/verify-resource-api.mjs",
    "verify:electron-host": "node scripts/verify-native-desktop.mjs",
    "verify:desktop-service": "node scripts/verify-native-desktop.mjs",
    "verify:desktop-stability": "node scripts/verify-native-desktop.mjs",
    "verify:desktop-recovery": "node scripts/verify-desktop-recovery.mjs",
    "verify:windows-bundle": "node scripts/verify-windows-bundle.mjs",
    "verify:approval": "node scripts/verify-native-baseline.mjs",
    "verify:resume": "node scripts/verify-native-baseline.mjs",
    "verify:tool-execution": "node scripts/verify-native-baseline.mjs",
    "verify:modules": "node scripts/verify-runtime-modules.mjs",
    "verify:channels": "node scripts/verify-channels.mjs",
    "verify:concurrency": "node scripts/verify-concurrency.mjs",
    "verify:persistence": "node scripts/verify-conversation-persistence.mjs",
    "verify:ui": "node scripts/verify-ui-modules.mjs",
    "verify:channel-live": "node scripts/verify-embuddies-runtime.mjs",
    "verify:auth": "node scripts/verify-api-auth.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "coverage": "node --experimental-test-coverage --test --test-isolation=none test/*.test.mjs",
    "lint": "eslint . && cd .. && node runtime/node_modules/eslint/bin/eslint.js desktop/*.cjs --config runtime/eslint.config.js",
    "format": "prettier --write \"*.mjs\" \"scripts/*.mjs\" \"test/*.mjs\" \"../shell/resources/js/{agent-client,channel-controller,icons,local-store,main,markdown-renderer,panel-controller,panel-state,pet-controller,run-activity}.js\" \"../shell/resources/*.{html,css}\"",
    "format:check": "prettier --check \"*.mjs\" \"scripts/*.mjs\" \"test/*.mjs\" \"../frontend/src/**/*.{ts,tsx,css}\" \"../frontend/vitest.config.ts\" \"../desktop/*.cjs\"",
    "verify:native-runtime": "node scripts/verify-native-baseline.mjs",
    "verify:native-desktop": "node scripts/verify-native-desktop.mjs",
    "verify:native-gc": "node scripts/verify-native-gc-desktop.mjs",
    "verify:native-platform": "node scripts/verify-native-platform.mjs",
    "verify:native-installer": "node scripts/verify-native-installer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "playwright": "^1.63.0",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
